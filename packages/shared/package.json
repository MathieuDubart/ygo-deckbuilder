{
  "name": "@ygo/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Contrats partag\u00e9s front/back : sch\u00e9mas zod, types, constantes m\u00e9tier.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ygo/tsconfig": "workspace:*",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
