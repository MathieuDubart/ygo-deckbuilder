# ─── Base de données ─────────────────────────────────────────────
DATABASE_URL=postgresql://ygo:ygo@localhost:5432/ygo?schema=public

# ─── Serveur ─────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Origine du front (CORS). Inutile si le front passe par le proxy /api de Next.
WEB_ORIGIN=http://localhost:3000

# ─── Auth ────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# true en prod (HTTPS obligatoire)
COOKIE_SECURE=false

# ─── Catalogue YGOPRODeck ───────────────────────────────────────
YGOPRODECK_BASE_URL=https://db.ygoprodeck.com/api/v7
# Sync auto (cron). Vide = désactivé. Défaut : tous les lundis à 4h.
CARD_SYNC_CRON=0 4 * * 1
# Lance une sync au démarrage si le catalogue est vide (1re install)
CARD_SYNC_ON_BOOT=true
# Email qui reçoit le rôle ADMIN à l'inscription (import meta decks, sync manuelle)
ADMIN_EMAIL=
# Visuels HD des produits (tins, structure decks…) récupérés sur Yugipedia
PRODUCT_COVERS_ENABLED=true
# Meta automatique (listes de tournoi YGOPRODeck). Vide = désactivé. Défaut : lundi 5h.
META_SYNC_CRON=0 5 * * 1
# Pages de ~20 listes à récupérer (15 ≈ 300 listes ≈ 1 mois de tournois)
META_SYNC_PAGES=15

# ─── Guides de deck par IA (optionnel) ────────────────────────────
# Sans IA, le guide est calculé à partir des effets des cartes (déjà complet).
# none | openai (toute API compatible : OpenAI, Mistral, Groq, LM Studio, Ollama…) | anthropic
AI_PROVIDER=none
# openai : défaut https://api.openai.com/v1 — LM Studio : http://localhost:1234/v1 — Ollama : http://localhost:11434/v1
AI_BASE_URL=
AI_API_KEY=
# Obligatoire si AI_PROVIDER est défini (ex. gpt-4o-mini, mistral-small-latest, claude-sonnet-4-5…)
AI_MODEL=
# Délai max d'une rédaction (ms). Modèle local lent → augmente (max 600000)
AI_TIMEOUT_MS=180000
