// ─────────────────────────────────────────────────────────────────────────────
// YGO Deck Builder — schéma de données
//
// Deux mondes séparés :
//   1. Catalogue (Card, CardSet, CardPrint) : données publiques synchronisées
//      depuis YGOPRODeck. Jamais modifiées par les utilisateurs.
//   2. Données utilisateur (User, CollectionItem, Deck, WishlistItem) : tout ce
//      qui appartient à un compte, toujours filtré par userId.
//   + MetaDeck : decklists de référence (tier list) pour le moteur de suggestion.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════ Catalogue ═══════════════════════════════════

enum CardCategory {
  MONSTER
  SPELL
  TRAP
  SKILL
  TOKEN
}

/// Une carte unique, identifiée par son passcode Konami (ex: 89631139 = Dragon Blanc aux Yeux Bleus).
model Card {
  id          Int          @id // passcode Konami
  name        String
  nameFr      String?
  category    CardCategory
  type        String // ex: "Effect Monster", "Quick-Play Spell Card"... (brut YGOPRODeck)
  frameType   String // normal, effect, fusion, synchro, xyz, link, spell, trap...
  desc        String
  descFr      String?
  archetype   String?
  attribute   String?
  race        String? // type de monstre (Dragon, Warrior...) ou sous-type de magie/piège
  level       Int? // niveau / rang
  atk         Int?
  def         Int?
  linkVal     Int?
  linkMarkers String[]
  scale       Int?
  isExtraDeck Boolean      @default(false)

  banTcg String?
  banOcg String?
  formats String[]
  tcgDate DateTime? @db.Date
  /// Vues de la fiche sur YGOPRODeck : proxy de popularité (départage les cartes génériques)
  popularity Int?

  /// Texte de recherche normalisé (FR + EN + archétype, sans accents ni ponctuation).
  /// Calculé en SQL par ygo_normalize() — voir migration "search".
  searchText String @default("")

  imageUrl        String?
  imageUrlSmall   String?
  priceCardmarket Decimal? @db.Decimal(10, 2)
  priceTcgplayer  Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prints          CardPrint[]
  arts            CardArt[]
  metaStat        CardMetaStat?
  collectionItems CollectionItem[]
  deckCards       DeckCard[]
  wishlistItems   WishlistItem[]
  metaDeckCards   MetaDeckCard[]
  effectTargets   CardEffectTarget[]
  translations    CardTranslation[]
  productDecks    ProductDeckCard[]
  tags            CardTag[]

  @@index([name])
  @@index([archetype])
  @@index([category])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// Artworks alternatifs : certains outils (decklists de tournoi, .ydk) utilisent leur ID
/// (ex: Ash Blossom 14558128 au lieu de 14558127). On les résout vers la carte principale.
model CardArt {
  id     Int @id
  cardId Int

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

/// Un produit/édition (booster, structure deck, tin...).
model CardSet {
  id        String    @id @default(cuid())
  name      String    @unique
  code      String? // préfixe, ex: "SDBE" (pas unique : certains sets partagent un préfixe)
  cardCount Int?
  tcgDate   DateTime? @db.Date
  imageUrl  String? // visuel YGOPRODeck (petit)
  /// Visuel HD du produit (Yugipedia), prioritaire sur imageUrl
  coverUrl       String?
  /// Dernière recherche du visuel HD (null = jamais cherché)
  coverCheckedAt DateTime?
  /// Nom normalisé pour la recherche (cf. Card.searchText)
  searchText String @default("")
  /// Dernière lecture de la liste officielle (quantités) ; contentSource = d'où elle vient
  contentCheckedAt DateTime?
  contentSource    String?
  /// Relevée parmi les sorties annoncées (Yugipedia) : la date est fiable même si aucune
  /// impression n'est encore connue. Null = extension vue uniquement par le catalogue.
  announcedAt      DateTime?

  prints        CardPrint[]
  ownedProducts OwnedProduct[]
  decks         ProductDeck[]
  tags          SetTag[]
  progress      SetProgress[]

  @@index([tcgDate])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// Une impression précise d'une carte dans un set, avec sa rareté (ex: LOB-EN001 Ultra Rare).
model CardPrint {
  id         String   @id @default(cuid())
  cardId     Int
  setId      String
  printCode  String // ex: "LOB-EN001"
  rarity     String
  rarityCode String?
  price      Decimal? @db.Decimal(10, 2)
  /// Exemplaires de cette impression dans UN produit (liste officielle Yugipedia) ; null = inconnu
  setQuantity Int?

  card            Card             @relation(fields: [cardId], references: [id], onDelete: Cascade)
  set             CardSet          @relation(fields: [setId], references: [id], onDelete: Cascade)
  collectionItems CollectionItem[]
  wishlistItems   WishlistItem[]
  profileCards    ProfileCard[]

  @@unique([cardId, printCode, rarity])
  @@index([setId])
  @@index([printCode])
}

/// Métadonnées de synchronisation du catalogue.
model SyncState {
  id              String   @id // ex: "ygoprodeck"
  databaseVersion String?
  lastSyncAt      DateTime?
  lastStatus      String?
  lastError       String?
  cardCount       Int      @default(0)
}

// ═══════════════════════════════ Utilisateurs ════════════════════════════════

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         UserRole @default(USER)
  /// Chemins relatifs dans UPLOADS_DIR, jamais une URL : l'hôte peut changer
  avatarPath String?
  bannerPath String?
  /// Langue dans laquelle on range sa collection, indépendante de celle de l'interface :
  /// on peut lire l'app en français et collectionner en anglais. Null = jamais choisie,
  /// on retombe alors sur la langue de la requête.
  collectionLanguage CardLanguage?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  refreshTokens   RefreshToken[]
  collectionItems CollectionItem[]
  decks           Deck[]
  wishlistItems   WishlistItem[]
  ownedProducts   OwnedProduct[]
  tags            Tag[]
  setProgress     SetProgress[]
  friendshipsSent     Friendship[] @relation("FriendshipsSent")
  friendshipsReceived Friendship[] @relation("FriendshipsReceived")
  profileCards        ProfileCard[]
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

/// Une seule ligne par relation, orientée par celui qui a demandé. Les deux sens sont donc
/// à interroger : un ami peut être le demandeur comme le destinataire. Un index unique sur
/// la paire non ordonnée (posé par la migration) empêche les demandes croisées en double.
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  requester User @relation("FriendshipsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

/// Cartes mises en avant sur le profil. Une impression, pas une carte : on montre l'édition
/// qu'on possède. La possession est vérifiée à l'écriture ET à la lecture — une carte vendue
/// entre-temps ne doit pas rester exposée.
model ProfileCard {
  userId   String
  printId  String
  position Int
  addedAt  DateTime @default(now())

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  print CardPrint @relation(fields: [printId], references: [id], onDelete: Cascade)

  @@id([userId, printId])
  @@index([userId, position])
}

/// Avancement d'un utilisateur sur une extension : ce qu'il en a sur ce qu'elle contient.
/// Dénormalisation assumée — les mêmes chiffres se déduisent de CollectionItem × CardPrint,
/// mais les rejouer à chaque affichage coûte cher et ils servent ailleurs que dans la liste.
/// Tenue à jour par `SetProgressService` à chaque mouvement de collection, et reconstruite
/// après une synchro du catalogue (de nouvelles impressions changent les totaux).
/// Une ligne n'existe que si l'utilisateur possède au moins une carte de l'extension.
model SetProgress {
  userId String
  setId  String

  /// Impressions et cartes distinctes de l'extension, au moment du calcul
  prints Int @default(0)
  cards  Int @default(0)
  /// Impressions de l'extension présentes dans la collection
  ownedPrints Int @default(0)
  /// Cartes de l'extension possédées, toutes éditions confondues
  ownedCards Int @default(0)
  /// Exemplaires rattachés à une impression de l'extension
  copies    Int      @default(0)
  updatedAt DateTime @default(now())

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  set  CardSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@id([userId, setId])
  @@index([setId])
}

/// Étiquette libre d'un utilisateur (« à vendre », « doublons », « deck Blue-Eyes »), posable
/// sur une carte ou sur une extension. Les facettes de tri (archétype, rareté, année…) sont
/// calculées depuis le catalogue et n'ont rien à voir avec ces étiquettes.
model Tag {
  id        String   @id @default(cuid())
  userId    String
  name      String
  /// Couleur de la pastille : un slug du jeu de couleurs du front, pas une valeur CSS
  color     String   @default("slate")
  createdAt DateTime @default(now())

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards CardTag[]
  sets  SetTag[]
  decks DeckTag[]

  @@unique([userId, name])
  @@index([userId])
}

/// Étiquette posée sur un deck.
model DeckTag {
  tagId  String
  deckId String

  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@id([tagId, deckId])
  @@index([deckId])
}

/// Étiquette posée sur une carte, toutes impressions confondues.
model CardTag {
  tagId  String
  cardId Int

  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([tagId, cardId])
  @@index([cardId])
}

/// Étiquette posée sur une extension (qu'on la possède ou non).
model SetTag {
  tagId String
  setId String

  tag Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  set CardSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@id([tagId, setId])
  @@index([setId])
}

/// Refresh tokens stockés hashés (rotation à chaque refresh, révocables).
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ═══════════════════════════════ Collection ══════════════════════════════════

enum CardCondition {
  MINT
  NEAR_MINT
  EXCELLENT
  GOOD
  LIGHT_PLAYED
  PLAYED
  POOR
}

enum CardLanguage {
  FR
  EN
  DE
  IT
  ES
  PT
  JP
  KR
}

/// Une "pile" d'exemplaires identiques possédés (même carte, même print, même état, même langue).
model CollectionItem {
  id           String        @id @default(cuid())
  userId       String
  cardId       Int
  printId      String?
  quantity     Int           @default(1)
  condition    CardCondition @default(NEAR_MINT)
  language     CardLanguage  @default(FR)
  firstEdition Boolean       @default(false)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  card  Card       @relation(fields: [cardId], references: [id])
  print CardPrint? @relation(fields: [printId], references: [id], onDelete: SetNull)

  @@index([userId, cardId])
  @@index([userId, printId])
}

// ═══════════════════════════════ Decks ═══════════════════════════════════════

enum DeckFormat {
  TCG
  OCG
  GOAT
  EDISON
  CASUAL
}

enum DeckZone {
  MAIN
  EXTRA
  SIDE
}

model Deck {
  id          String     @id @default(cuid())
  userId      String
  name        String
  description String?
  format      DeckFormat @default(TCG)
  isPublic    Boolean    @default(false)
  /// Liste officielle dont ce deck a été monté, le cas échéant. L'unicité par utilisateur
  /// est ce qui rend le montage rejouable : l'import et le rattrapage visent la même ligne.
  productDeckId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  productDeck   ProductDeck?   @relation(fields: [productDeckId], references: [id], onDelete: SetNull)
  cards         DeckCard[]
  tags          DeckTag[]
  wishlistItems WishlistItem[]

  @@unique([userId, productDeckId])
  @@index([userId])
}

model DeckCard {
  deckId   String
  cardId   Int
  zone     DeckZone
  quantity Int

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id])

  @@id([deckId, cardId, zone])
}

// ═══════════════════════════════ Wishlist ════════════════════════════════════

enum WishlistPriority {
  LOW
  MEDIUM
  HIGH
}

/// Carte recherchée, avec l'édition/print visé, le budget et éventuellement le deck qui la réclame.
model WishlistItem {
  id        String           @id @default(cuid())
  userId    String
  cardId    Int
  printId   String?
  deckId    String?
  quantity  Int              @default(1)
  maxPrice  Decimal?         @db.Decimal(10, 2)
  language  CardLanguage?
  priority  WishlistPriority @default(MEDIUM)
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  card  Card       @relation(fields: [cardId], references: [id])
  print CardPrint? @relation(fields: [printId], references: [id], onDelete: SetNull)
  deck  Deck?      @relation(fields: [deckId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// ═══════════════════════════════ Meta ════════════════════════════════════════

/// Archétype du meta : soit calculé automatiquement à partir des listes de tournoi
/// (source = "tournaments"), soit importé à la main depuis un .ydk (source = "manual").
model MetaDeck {
  id        String     @id @default(cuid())
  name      String
  archetype String?
  tier      Int?
  format    DeckFormat @default(TCG)
  source    String? // "tournaments" | "manual"
  sourceUrl String?
  /// Nombre de listes de tournoi regroupées dans cet archétype
  listCount Int        @default(0)
  /// Part des listes récentes (0..1)
  share     Float?
  /// Autres noms rencontrés pour ce deck ("Azamina Mitsurugi…")
  variants  String[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  cards MetaDeckCard[]
  lists TournamentDeck[]

  @@unique([name, format])
}

model MetaDeckCard {
  metaDeckId String
  cardId     Int
  zone       DeckZone
  quantity   Int
  /// Part des listes de l'archétype qui jouent cette carte (1 = toutes)
  inclusion  Float    @default(1)
  /// Carte "flex" : jouée par une partie des listes mais hors liste type (sert aux substitutions)
  flex       Boolean  @default(false)

  metaDeck MetaDeck @relation(fields: [metaDeckId], references: [id], onDelete: Cascade)
  card     Card     @relation(fields: [cardId], references: [id])

  @@id([metaDeckId, cardId, zone])
}

/// Decklist de tournoi brute (YGOPRODeck "Tournament Meta Decks"), IDs déjà résolus.
model TournamentDeck {
  id          Int      @id // deckNum YGOPRODeck
  name        String
  tournament  String?
  placement   String?
  playerCount Int?
  main        Int[]
  extra       Int[]
  side        Int[]
  url         String?
  fetchedAt   DateTime @default(now())
  metaDeckId  String?

  metaDeck MetaDeck? @relation(fields: [metaDeckId], references: [id], onDelete: SetNull)

  @@index([metaDeckId])
}

/// Popularité d'une carte dans le meta : sert à repérer les "staples" (Ash Blossom, Nibiru…).
model CardMetaStat {
  cardId    Int      @id
  /// Part des listes de tournoi récentes qui la jouent (main ou extra)
  deckShare Float
  /// Nombre moyen d'exemplaires quand elle est jouée
  avgCopies Float
  /// Jouée par plusieurs archétypes différents (hand traps, board breakers…)
  isStaple  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

/// Guides de deck rédigés par l'IA (clé = empreinte de la liste + modèle) : évite de repayer
/// la même génération. Les guides calculés ne sont pas mis en cache (instantanés).
model DeckGuideCache {
  key       String   @id
  model     String
  content   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Cibles "précises" des effets de chaque carte (cite un nom / archétype, ou filtre serré),
/// lues dans son texte à chaque sync du catalogue. Sert à la question inverse :
/// « quelles cartes peuvent chercher / invoquer / utiliser celle-ci ? ».
/// Les cibles génériques ("1 monster") ne sont pas stockées : elles visent tout le monde.
model CardEffectTarget {
  id         Int      @id @default(autoincrement())
  cardId     Int
  /// SEARCH, SPECIAL_SUMMON, SEND_GY, RECOVER, SUMMON_EXTRA, MATERIAL, MENTION
  verb       String
  locations  String[]
  /// Noms / archétypes cités, tels quels (pour le contrôle exact)
  quoted     String[]
  /// Les mêmes en minuscules (index GIN pour la recherche inverse)
  keys       String[]
  except     String[]
  kinds      String[]
  subtypes   String[]
  races      String[]
  attributes String[]
  levelEq    Int?
  levelMin   Int?
  levelMax   Int?
  tuner      Boolean?
  nonTuner   Boolean?
  /// 2 = direct (nom / archétype) · 1 = précis (filtre serré)
  precision  Int

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([keys], type: Gin)
  @@index([precision])
}

/// Produit ajouté à la collection (structure deck, tin…) : on garde la trace de l'achat pour
/// retrouver son contenu, le reconstituer, et proposer un guide de jeu pour les decks.
model OwnedProduct {
  id        String       @id @default(cuid())
  userId    String
  setId     String
  /// Nombre de produits identiques
  copies    Int          @default(1)
  language  CardLanguage @default(FR)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  set  CardSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([userId, setId, language])
  @@index([userId])
}

/// Nom et texte d'une carte dans une autre langue que l'anglais / le français (de, it, pt),
/// fournis par YGOPRODeck. Le français reste dans Card.nameFr / descFr.
model CardTranslation {
  cardId Int
  locale String
  name   String
  desc   String

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([cardId, locale])
  @@index([locale])
}

/// Deck préconstruit d'un produit (structure deck, starter, deck d'un coffret comme
/// « Legendary 5D's Decks » ou « 2-Player Starter Set »), d'après la liste officielle Yugipedia.
model ProductDeck {
  id       String  @id @default(cuid())
  setId    String
  /// Nom de la section (« Yusei Deck ») ; null = le produit est un seul deck
  name     String?
  position Int     @default(0)

  set   CardSet           @relation(fields: [setId], references: [id], onDelete: Cascade)
  cards ProductDeckCard[]
  decks Deck[]

  @@index([setId])
}

model ProductDeckCard {
  deckId   String
  cardId   Int
  quantity Int

  deck ProductDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([deckId, cardId])
  @@index([cardId])
}
