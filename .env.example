# ─── Variables pour docker-compose.yml (prod / selfhost) ───────────────
# Pour le dev local, voir apps/api/.env.example et apps/web/.env.example

POSTGRES_USER=ygo
POSTGRES_PASSWORD=          # openssl rand -base64 24
POSTGRES_DB=ygo

JWT_ACCESS_SECRET=          # openssl rand -base64 48

# URL publique du site (HTTPS en prod)
PUBLIC_URL=https://ygo.example.com
COOKIE_SECURE=true          # false seulement si tu testes en HTTP local
WEB_PORT=3000

# Sync auto du catalogue YGOPRODeck (cron). Vide = désactivée.
CARD_SYNC_CRON=0 4 * * 1

# Ce compte devient ADMIN à l'inscription (import meta decks, sync manuelle)
ADMIN_EMAIL=

# Meta automatique à partir des tournois récents (cron). Vide = désactivé.
META_SYNC_CRON=0 5 * * 1

# ─── Guides de deck par IA (optionnel) ────────────────────────────
# Sans IA, le guide est calculé à partir des effets des cartes (déjà complet).
# none | openai (toute API compatible : OpenAI, Mistral, Groq, LM Studio, Ollama…) | anthropic
AI_PROVIDER=none
# openai : défaut https://api.openai.com/v1 — LM Studio : http://localhost:1234/v1 — Ollama : http://localhost:11434/v1
AI_BASE_URL=
AI_API_KEY=
# Obligatoire si AI_PROVIDER est défini (ex. gpt-4o-mini, mistral-small-latest, claude-sonnet-4-5…)
AI_MODEL=
